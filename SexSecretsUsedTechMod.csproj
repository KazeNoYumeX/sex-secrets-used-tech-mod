<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>SexSecretsUsedTechMod</AssemblyName>
    <RootNamespace>SexSecretsUsedTechMod</RootNamespace>
    <Version>1.0.0</Version>
    <Product>SexSecretsUsedTechMod</Product>
    <DebugType>none</DebugType>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GamePath Condition="'$(GamePath)' == ''"
      >C:\Program Files (x86)\Steam\steamapps\common\ElectronicStore</GamePath>
  </PropertyGroup>

  <!-- IL2CPP game: BepInEx itself and the interop assemblies it generates on the first launch (BepInEx\interop) -->
  <ItemGroup>
    <Reference
      Include="$(GamePath)\BepInEx\core\BepInEx.*.dll;$(GamePath)\BepInEx\core\0Harmony.dll;$(GamePath)\BepInEx\core\Il2CppInterop.*.dll"
      Private="false"
    />
    <Reference Include="$(GamePath)\BepInEx\interop\*.dll" Private="false" />
  </ItemGroup>

  <Target
    Name="DeployToGame"
    AfterTargets="Build"
    Condition="Exists('$(GamePath)\BepInEx\plugins')"
  >
    <Copy
      SourceFiles="$(TargetPath)"
      DestinationFolder="$(GamePath)\BepInEx\plugins\SexSecretsUsedTechMod"
    />
  </Target>
</Project>
